# Copy to .env and fill in real values

# ---- Core ----
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./algonovo.db
ACCESS_TOKEN_MINUTES=1440
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# ---- Admin seed ----
ADMIN_EMAIL=admin@algonovo.pt
ADMIN_PASSWORD=1234567

# ---- Public frontend base URL (used for OAuth redirects) ----
FRONTEND_URL=http://127.0.0.1:5500/html/Algo Novo.dc.html

# ---- OAuth (leave empty to hide provider button) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# OAuth callback base (must match what you register at each provider)
OAUTH_CALLBACK_BASE=http://127.0.0.1:8000
